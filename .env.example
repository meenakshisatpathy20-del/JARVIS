# Copy to .env and fill in. .env is git-ignored.
POSTGRES_PASSWORD=change-me-superuser
APP_DB_PASSWORD=change-me-app
CHAOS_DB_PASSWORD=change-me-chaos
CHAOS_TOKEN=change-me-chaos-token
# Services must send this header to /ingest and /webhook/alert (blocks fake telemetry)
INGEST_TOKEN=change-me-ingest-token
# J.A.R.V.I.S. signs every diagnosis; chaos verifies it before Reveal (blocks faked blind-test wins).
# Shared through .env only: chaos and J.A.R.V.I.S. still share no network.
DIAGNOSIS_SIGNING_KEY=change-me-signing-key
# Optional: without it J.A.R.V.I.S. uses the template report.
GEMINI_API_KEY=
